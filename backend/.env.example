# Copy to .env and fill in what you use. Everything works without any of this
# (local embeddings + Ollama), these are only for the paid upgrades.

# OPENAI_API_KEY=sk-...

# Use OpenAI embeddings instead of local:  REPOCHAT_USE_OPENAI_EMBEDDINGS=1
# Use OpenAI for answers instead of Ollama: REPOCHAT_LLM_PROVIDER=openai
